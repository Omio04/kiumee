# 이 파일을 local.properties 로 복사해서 쓰세요 (local.properties 는 git에 올라가지 않습니다)

# Android SDK 위치 (Android Studio 로 열면 자동으로 만들어집니다)
sdk.dir=C:/Users/<이름>/AppData/Local/Android/Sdk

# 서버 주소: 클라우드에 올렸다면 그 주소(https://...), 내 PC 서버를 쓰면 http://127.0.0.1:8080 (USB 연결 + adb reverse tcp:8080 tcp:8080)
kl.serverUrl=https://<서버 주소>

# 앱 키: 서버의 APP_KEY 와 같은 값. (Claude 키가 아닙니다. Claude 키는 서버에만 둡니다)
kl.appKey=<서버의 APP_KEY>

# 선택 항목 (기본값이면 쓰지 않아도 됩니다)
# kl.helpMode=false        # 기본 켜짐: 물어볼 때만 답하는 도움 모드. 서버의 HELP_MODE 와 같아야 합니다
# kl.sendImage=false       # 질문할 때 카메라 사진을 AI에 보낼지 (기본 켜짐)
# kl.showRecognition=true  # 개발용: 글자 인식 결과를 화면에 표시
